{
  "data": {"data_dir": "processed_data", "input_padding_value": 0, "label_padding_value": -100},
  "model": {
    "name": "dilated_cnn", "vocabulary_size": 22, "embedding_dim": 24,
    "hidden_dim": 64, "kernel_size": 5, "dropout": 0.15, "num_classes": 3,
    "dilations": [1, 2, 4, 8]
  },
  "training": {
    "optimizer": "adamw", "learning_rate": 0.001, "batch_size": 64,
    "max_epochs": 8, "patience": 2, "seed": 42, "num_threads": 8,
    "weight_decay": 0.01, "gradient_clip_norm": 1.0, "selection_metric": "q3"
  },
  "runtime": {"device": "cpu", "output_dir": "outputs/runs/dilated_cnn"}
}
